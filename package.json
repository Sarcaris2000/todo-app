{
  "name": "todo-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Personal to-do app with cross-device sync and a 6am daily focus push",
  "scripts": {
    "test": "node scripts/selftest.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 execute todo --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute todo --remote --file=./schema.sql",
    "vapid": "node scripts/generate-vapid.mjs",
    "icons": "node scripts/make-icons.mjs",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
